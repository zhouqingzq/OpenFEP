{
  "name": "@segments/consciousness-tui",
  "version": "0.1.0-alpha.1",
  "private": true,
  "description": "Segmentum alpha terminal client.",
  "type": "module",
  "bin": {
    "consciousness-tui": "./dist/main.js"
  },
  "scripts": {
    "build:client": "npm --prefix ../packages/consciousness-client run build",
    "build": "npm run build:client && tsc -p tsconfig.json",
    "dev": "npm run build:client && tsx src/main.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@segments/consciousness-client": "file:../packages/consciousness-client"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
