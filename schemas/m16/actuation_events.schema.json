{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://segments.local/schemas/m16/actuation_events.schema.json",
  "title": "M16ActuationEvent",
  "type": "object",
  "additionalProperties": true,
  "required": ["type", "at", "persona_id", "session_id", "payload"],
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "AssistantMessagePreparedEvent",
        "AssistantMessageDeliveredEvent",
        "ProactiveMessagePreparedEvent",
        "ProactiveMessageDeliveredEvent",
        "ProactiveDeliverySuppressedEvent",
        "RunnerHealthEvent"
      ]
    },
    "at": { "type": "integer", "minimum": 0 },
    "persona_id": { "type": "string", "maxLength": 120 },
    "session_id": { "type": "string", "maxLength": 120 },
    "reason_code": { "type": "string", "maxLength": 96 },
    "payload": {
      "type": "object",
      "not": {
        "anyOf": [
          { "required": ["system_prompt"] },
          { "required": ["user_prompt"] },
          { "required": ["conscious_markdown"] },
          { "required": ["full_memory_dump"] },
          { "required": ["conscious_plan"] }
        ]
      }
    }
  }
}
