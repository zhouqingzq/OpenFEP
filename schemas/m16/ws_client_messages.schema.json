{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://segments.local/schemas/m16/ws_client_messages.schema.json",
  "title": "M16WebSocketClientMessage",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "message_id",
    "session_id",
    "persona_id",
    "at",
    "kind",
    "correlation_id",
    "payload"
  ],
  "properties": {
    "schema_version": { "const": "m16.0" },
    "message_id": { "type": "string", "maxLength": 120 },
    "session_id": { "type": "string", "maxLength": 120 },
    "persona_id": { "type": "string", "maxLength": 120 },
    "at": { "type": "integer", "minimum": 0 },
    "kind": {
      "type": "string",
      "enum": [
        "Subscribe",
        "Ping",
        "ClientInput",
        "DeliverySurfaceReady",
        "DeliveryAck",
        "Unsubscribe"
      ]
    },
    "correlation_id": { "type": "string", "maxLength": 120 },
    "payload": { "type": "object" }
  }
}
